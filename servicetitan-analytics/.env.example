# --- ServiceTitan API (OAuth2 client credentials) ---
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=
# production | integration
ST_ENV=production

# --- Transcription ---
# backend: deepgram | whisperx
TRANSCRIBE_BACKEND=deepgram
DEEPGRAM_API_KEY=

# --- LLM call analysis ---
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-fable-5

# --- Analysis periods (YoY) ---
# Текущий период; период год назад вычисляется автоматически (-1 год).
# Формат YYYY-MM-DD. Если пусто — берётся прошлый полный календарный месяц.
CURRENT_PERIOD_START=
CURRENT_PERIOD_END=
